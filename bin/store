#!/bin/sh

if [ $# -lt 2 ]; then
  echo "––––––––––––––––"
  echo "A simple key-value store for bash scripts"
  echo "USAGE: store set/get var_name [value]"
  echo "––––––––––––––––"
else
  var_name=$2

  dir="$HOME/tmp"
  file="$dir/${var_name}.dat"

  if ! mkdir -p "$dir" 2>/dev/null; then
    echo "Error: Cannot create $dir (permission denied)" >&2
    echo "Fix it by running: sudo chown $(whoami) $dir" >&2
    echo " " >&2
    exit 1
  fi

  if [ "$1" = 'set' ]; then
    # and save it for next time
    value=$3
    if ! echo "${value}" > "$file" 2>/dev/null; then
      echo "Error: Permission denied writing to $file" >&2
      echo "Fix it by running: sudo chown \$(whoami) $file" >&2
      echo " " >&2
      exit 1
    fi
  else
    if [ ! -e "$file" ]; then
      if ! : > "$file" 2>/dev/null; then
        echo "Error: Cannot create $file (permission denied)" >&2
        echo "Fix it by running: sudo chown $(whoami) $file" >&2
        echo " " >&2
        exit 1
      fi
    fi
    if [ ! -r "$file" ]; then
      echo "Error: Cannot read $file (permission denied)" >&2
      echo "Fix it by running: sudo chown $(whoami) $file" >&2
      echo " " >&2
      exit 1
    fi
    value=`cat "$file"`
    echo ${value};
  fi
fi
