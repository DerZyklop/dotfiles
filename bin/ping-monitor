#!/bin/sh

# Internal ping backend, used via prettyping's --pingbin (see doPrettyping).
# For each sequential packet we first try the primary IP; only if that gets no
# reply do we retry the *same* slot against the fallback IP. If neither answers
# we emit a timeout line, which prettyping renders as a lost packet ('!'). Every
# packet starts over at the primary, so recovery on 8.8.8.8 is picked up on the
# very next ping instead of being stuck on the fallback. All parameters arrive
# via PB_* env vars; the ping args prettyping appends to us are ignored.
if [ -n "$PINGBIN_MODE" ]; then
  # `-t 1` caps each probe at ~1s total, the floor macOS ping needs to conclude
  # "no reply". Without it a firewall-dropped primary stalls ~2s per packet.
  # When the host is up the reply returns in a few ms, so this only bites while
  # the primary is actually down (the unavoidable cost of detecting that).
  seq=0
  while [ "$seq" -lt "$PB_COUNT" ]; do
    reply=$(ping -c 1 -t 1 "$PB_PRIMARY" 2>/dev/null | grep -m 1 'icmp_seq=')
    if [ -z "$reply" ] && [ -n "$PB_FALLBACK" ]; then
      reply=$(ping -c 1 -t 1 "$PB_FALLBACK" 2>/dev/null | grep -m 1 'icmp_seq=')
    fi
    if [ -n "$reply" ]; then
      # A single `ping -c 1` always reports icmp_seq=0; rewrite it to our running
      # counter so prettyping tracks packet order and loss correctly.
      echo "$reply" | sed -E "s/icmp_seq=[0-9]+/icmp_seq=$seq/"
    else
      echo "Request timeout for icmp_seq $seq"
    fi
    seq=$((seq + 1))
    sleep "$PB_INTERVAL"
  done
  exit 0
fi

if [[ $1 =~ ^-h|--help ]]; then
  echo "USAGE:"
  echo ""
  echo "ping-monitor [time-interval] [ping-interval] [ip]"
  echo ""
  echo "[time-interval] is the time from one time output line to another. Defaults to 30 minutes"
  echo "[ping-interval] is the time from one ping-interval to another. Defaults to 200ms"
else
  trap "echo EXIT;  exit" 0
  trap "echo HUP;   exit" 1
  trap "echo CTL-C; exit" 2
  trap "echo QUIT;  exit" 3
  trap "echo ERR;   exit" ERR

  # Arguments may be given in any order: a plain number is treated positionally
  # (first number = time-interval in minutes, second = ping-interval in ms),
  # while anything non-numeric (an IPv4 address or hostname) is taken as the IP.
  # This lets `ping-monitor 192.168.1.46` do what you'd expect.
  for arg in "$@"; do
    if [[ $arg =~ ^[0-9]+$ ]]; then
      if [ -z "${SHOW_TIME_INTERVAL_DURATION_IN_MINUTES}" ]; then
        SHOW_TIME_INTERVAL_DURATION_IN_MINUTES=$arg
      else
        PING_INTERVAL_DURATION_IN_MILLISECONDS=$arg
      fi
    else
      IP=$arg
    fi
  done

  if [ -z ${SHOW_TIME_INTERVAL_DURATION_IN_MINUTES} ]; then SHOW_TIME_INTERVAL_DURATION_IN_MINUTES=30; fi;
  if [ -z ${PING_INTERVAL_DURATION_IN_MILLISECONDS} ]; then PING_INTERVAL_DURATION_IN_MILLISECONDS=200; fi;

  # When the user passes an explicit IP we ping *only* that IP (they want to test
  # that exact host). Without one we want to know whether we have internet at all,
  # so we ping 8.8.8.8 and, per packet, fall back to 1.1.1.1 if it doesn't answer.
  if [ -z ${IP} ]; then
    IP='8.8.8.8'
    FALLBACK_IP='1.1.1.1'
  fi;

  SHOW_TIME_INTERVAL_DURATION_IN_MMILLISECONDS=$(($SHOW_TIME_INTERVAL_DURATION_IN_MINUTES * 60 * 1000))

  echo 'Will show Time every '$SHOW_TIME_INTERVAL_DURATION_IN_MINUTES' minutes'

  COUNT=$(($SHOW_TIME_INTERVAL_DURATION_IN_MMILLISECONDS / $PING_INTERVAL_DURATION_IN_MILLISECONDS))

  PING_INTERVAL_DURATION_IN_SECONDS=$(($PING_INTERVAL_DURATION_IN_MILLISECONDS / 1000))
  if [[ $PING_INTERVAL_DURATION_IN_SECONDS -eq 0 ]]; then
    PING_INTERVAL_DURATION_IN_SECONDS=0.$(($PING_INTERVAL_DURATION_IN_MILLISECONDS / 100))
  fi

  GREEN='\033[0;32m'
  NC='\033[0m' # No Color

  # Absolute (or PATH-resolvable) path to this script, so prettyping can call us
  # back as its --pingbin backend.
  SELF=$0
  case "$SELF" in
    */*) : ;;
    *) SELF=$(command -v "$SELF" 2>/dev/null || echo "$SELF") ;;
  esac

  function doPrettyping() {
    START=$(date +%s)
    if [ -n "${FALLBACK_IP}" ]; then
      # No explicit IP: drive prettyping with our own backend so each packet
      # tries the primary first and only falls back per-packet.
      echo "\n${GREEN}$(date +"%I:%M") (${IP} \xe2\x87\xa2 ${FALLBACK_IP})${NC}\n"
      PINGBIN_MODE=1 PB_PRIMARY="$IP" PB_FALLBACK="$FALLBACK_IP" \
        PB_COUNT="$COUNT" PB_INTERVAL="$PING_INTERVAL_DURATION_IN_SECONDS" \
        prettyping -c $COUNT --pingbin "$SELF" -i $PING_INTERVAL_DURATION_IN_SECONDS "$IP" \
          --nostatistics --nomulticolor --nolegend --inverted
    else
      echo "\n${GREEN}$(date +"%I:%M") (${IP})${NC}\n"
      prettyping -c $COUNT "$IP" -i $PING_INTERVAL_DURATION_IN_SECONDS --nostatistics --nomulticolor --nolegend --inverted
    fi
    # If prettyping bails out almost immediately (e.g. a bad explicit IP), don't
    # busy-loop — pause before restarting.
    if [ $(($(date +%s) - START)) -lt 3 ]; then sleep 2; fi
    doPrettyping
  }

  doPrettyping
fi
