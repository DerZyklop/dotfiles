#!/bin/sh

# TODO: This can be improved with wildcards
# See: https://github.com/raineorshine/npm-check-updates/releases/tag/v11.2.0

echo 'ncu -u --target=minor $1 | grep "$1" | grep -o "[0-9].*"'
COMMIT_DESC=$(ncu -u $1 | grep "$1" | grep -o "[0-9].*");
if [ "$COMMIT_DESC" = "" ]; then
  echo "commit message broken: »$($COMMIT_DESC)«"
  exit 1
fi
npm install
git add package.json package-lock.json
echo ""
echo ""
echo "################################################################################"
echo "📦 ⬆ $1"
echo "Changed Version number of $1: $COMMIT_DESC"
echo "################################################################################"
echo ""
git commit -m "📦 ⬆ $1" -m "Changed Version number of $1: $COMMIT_DESC"
