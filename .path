# More important than brew stuff is the java version that i usually install manually.
# I install it manually to make sure i have the same java version than my colleagues.
export JAVA_HOME=$(/usr/libexec/java_home -v 21)
export PATH=$JAVA_HOME/bin:$PATH

# get my own commands
export PATH=~/S/prettyping:$PATH # NOTE: This path has prio 2 after $DOTFILESDIR/bin
export PATH=$DOTFILESDIR/bin:$PATH

# needed for the kirby cli
export PATH=~/.composer/vendor/bin:$PATH

# Postgres
export PATH="/opt/homebrew/opt/postgresql@18/bin:$PATH"

# Homebrew for this user
BREW_PREFIX="/opt/brew$(id -un)"
if [ -x "$BREW_PREFIX/bin/brew" ]; then
  eval "$("$BREW_PREFIX/bin/brew" shellenv bash)"
fi
